<?xml version="1.0" encoding="utf-8"?>
<!--
  PC 健康診断のパッケージマニフェスト（ひな形）。このままでは使えない。
  Build-Msix.ps1 が $…$ の差し込み口を埋めてから MakeAppx に渡す。

  $IDENTITY_NAME$ / $PUBLISHER$ / $PUBLISHER_DISPLAY_NAME$ / $DISPLAY_NAME$
      identity\dev.psd1（sideload の検証用）か identity\store.psd1（Store 提出用）から入る。
      ★ Store 提出用の値は Partner Center の「製品 ID」から identity\store.psd1 に転記する ★
  $VERSION$
      Directory.Build.props の Version に ".0" を付けたもの。4 桁目は Store が使うので常に 0。

  製品の exe（src/PcReport）は一切変えずに、そのまま同梱する。
  文言は specification/store/STORE_LISTING_ja.md の原案に合わせている。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DISPLAY_NAME$</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Description>ダブルクリックするだけで、この PC の健康診断の結果を 1 枚の HTML にまとめます。通信しません。人に送れる形で残せます。</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 18362 = Windows 10 1903。.NET Framework 4.8 が同梱されたのはこの版から（1809 は 4.7.2）。MinVersion は OS のビルドしか見ないので、
         4.8 の無い 1809 で「入れられるのに起動しない」を避けるため 1903 を下限にする（SPEC §9-9）。依存パッケージは無い -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
  </Resources>

  <Applications>
    <Application Id="PcReport" Executable="PcReport.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$DISPLAY_NAME$"
        Description="ダブルクリックするだけで、この PC の健康診断の結果を 1 枚の HTML にまとめます。通信しません。人に送れる形で残せます。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- Win32（.NET Framework）の exe をそのまま動かすのに必須。これ以外の capability は宣言しない -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
